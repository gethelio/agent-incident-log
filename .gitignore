# Dependencies
node_modules/

# Secrets — never commit these to a public repository
.env
.env.*
*.pem
*.key

# Internal working documents, not for publication
.local/

# Local tooling and editor state
.claude/
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# NOTE: dist/ is deliberately NOT ignored. incidents.json is generated by
# scripts/build.mjs but committed on purpose — it is the public dataset that
# helio.so and third-party consumers fetch. See dist/README.md.
